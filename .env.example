NODE_ENV=development
APP_NAME=mandarin-photoprotocol

# Database
DATABASE_URL=postgresql://photoprotocol:photoprotocol@localhost:5432/photoprotocol?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-local-jwt-secret-min-32-chars
SESSION_SECRET=change-me-local-session-secret-min-32
JWT_EXPIRES_IN=8h

# App URLs
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PORT=3001
WEB_PORT=3000

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=photoprotocol
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Upload limits (technical only — no business photo count limits)
MAX_SINGLE_FILE_SIZE_MB=100
MAX_UPLOAD_CONCURRENCY=5
MAX_STORAGE_QUOTA_GB=500
ALLOWED_PHOTO_FORMATS=jpg,jpeg,png,tiff
ALLOWED_VIDEO_FORMATS=mp4,mov
ALLOWED_DOCUMENT_FORMATS=pdf
ALLOWED_RADIOLOGY_FORMATS=jpg,jpeg,png,pdf,dcm,dicom,zip

# MIS / 1C modes
# standalone: MIS_PROVIDER=none, STOMA1C_INTEGRATION_ENABLED=false
# ready:     MIS_PROVIDER=stoma1c, STOMA1C_INTEGRATION_ENABLED=false
# integrated:MIS_PROVIDER=stoma1c, STOMA1C_INTEGRATION_ENABLED=true
MIS_PROVIDER=none
STOMA1C_INTEGRATION_ENABLED=false
STOMA1C_API_BASE_URL=
STOMA1C_API_TOKEN=
STOMA1C_DATABASE_ID=

# Yandex AI Studio / Alice AI
# mock:  AI_PROVIDER=mock, YANDEX_AI_ENABLED=false
# real:  AI_PROVIDER=yandex, YANDEX_AI_ENABLED=true
AI_PROVIDER=mock
YANDEX_AI_ENABLED=false
YANDEX_CLOUD_FOLDER_ID=
YANDEX_AI_MODEL_URI=
YANDEX_AI_FLASH_MODEL_URI=
YANDEX_DATA_LOGGING_ENABLED=false
YANDEX_AI_TIMEOUT_MS=60000
YANDEX_AI_MAX_RETRIES=3
YANDEX_MEDIA_CLASSIFIER_MODE=mock
YANDEX_LOCKBOX_SECRET_ID=
YANDEX_IAM_TOKEN=
YANDEX_API_KEY=

# Media processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ENABLE_VIRUS_SCAN=false

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
