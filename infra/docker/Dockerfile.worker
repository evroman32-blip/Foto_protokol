FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* turbo.json tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps ./apps
ENV NODE_ENV=development
RUN npm install
RUN mkdir -p node_modules/@mandarin \
    && for p in contracts domain config database file-processing yandex-ai stoma1c ui testing; do \
       if [ -d "packages/$p" ]; then ln -sfn "/app/packages/$p" "node_modules/@mandarin/$p"; fi; \
     done

FROM deps AS runner
WORKDIR /app
ENV NODE_ENV=development
RUN npx prisma generate --schema packages/database/prisma/schema.prisma
RUN npm run build -w @mandarin/contracts
RUN npm run build -w @mandarin/config
RUN npm run build -w @mandarin/database
RUN npm run build -w @mandarin/file-processing || true
RUN npm run build -w @mandarin/yandex-ai || true
WORKDIR /app/apps/worker
ENV NODE_ENV=production
CMD ["/app/node_modules/.bin/tsx", "src/main.ts"]
