# === Timeweb DEMO env ===
# Скопируйте:  cp .env.demo.example .env.demo
# Замените YOUR_DOMAIN на IP сервера или домен (без https:// и без слэша в конце)

PUBLIC_HOST=YOUR_DOMAIN
WEB_URL=http://YOUR_DOMAIN
API_URL=http://YOUR_DOMAIN
CORS_ORIGIN=http://YOUR_DOMAIN,http://msi-fotoprotocol.ru
# Пусто = браузер ходит на тот же origin (/api/...), nginx проксирует в Nest
NEXT_PUBLIC_API_URL=

# HTTP по умолчанию. HTTPS включает infra/scripts/enable-https.sh:
# он ставит NGINX_CONF=./infra/nginx/demo-ssl.conf, AUTH_COOKIE_SECURE=true
# и переписывает адреса выше на https://
NGINX_CONF=./infra/nginx/demo.conf
AUTH_COOKIE_SECURE=false

# Auth (сгенерируйте свои!)
JWT_SECRET=replace-with-long-random-jwt-secret-min-32-chars
SESSION_SECRET=replace-with-long-random-session-secret-min-32

# Первый модератор (создаётся при первом seed, пароль не перезаписывается при рестарте)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Database
POSTGRES_USER=photoprotocol
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=photoprotocol

# S3 / MinIO
S3_ACCESS_KEY=demoaccesskey
S3_SECRET_ACCESS_KEY=replace-strong-minio-secret
S3_BUCKET=photoprotocol
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Прямой MinIO (порт 9000). Не используйте /storage — ломает подпись URL
S3_PUBLIC_ENDPOINT=http://YOUR_DOMAIN:9000

# App
NODE_ENV=production
AI_PROVIDER=mock
YANDEX_AI_ENABLED=false
MIS_PROVIDER=none
STOMA1C_INTEGRATION_ENABLED=false
RUN_SEED_ON_START=true
API_PORT=3001
WEB_PORT=3000
